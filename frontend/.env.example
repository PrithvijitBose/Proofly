# Backend API Base URL Configuration (Set to your deployed Vercel backend URL in production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Production example:
# NEXT_PUBLIC_API_BASE_URL=https://proofly-backend.vercel.app

# --- GitHub OAuth (Auth.js v5) ---
# Option A (SaaS / Production): Standard 1-click GitHub OAuth setup.
# 1) Create an OAuth App at https://github.com/settings/developers
#    Homepage URL: http://localhost:3000 (Local) or https://proofly.vercel.app (Production)
#    Authorization callback URL: http://localhost:3000/api/auth/callback/github (Local) or https://proofly.vercel.app/api/auth/callback/github (Prod)
# 2) Copy the Client ID / Client Secret below.
# 3) Generate AUTH_SECRET with: npx auth secret

# GitHub OAuth application credentials
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# Auth.js secret used to encrypt session JWTs (>= 32 chars, random)
AUTH_SECRET=generate_a_random_secret_here

# CRITICAL for Vercel / serverless deployments:
AUTH_TRUST_HOST=true

# Where the frontend is deployed (used by Auth.js for callback URLs)
# Local: defaults to http://localhost:3000 — set explicitly for Vercel:
# AUTH_URL=https://proofly-frontend.vercel.app

# Option B (PAT Token Input): Users can also paste their own GitHub PAT token (ghp_...) directly in the UI if OAuth is not used.